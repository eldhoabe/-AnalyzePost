# Copy to backend/.env (gitignored) and fill in your key. Never commit a real key.
# Loaded via: uvicorn app.main:app --env-file .env

# Your OpenRouter key -- https://openrouter.ai/keys
JEV_API_KEY=sk-or-v1-replace-me

# Chrome extension ID (find it at chrome://extensions after loading unpacked)
CHROME_EXTENSION_ID=your-extension-id-here

# Defaults; only set these to override.
JEV_API_URL=https://openrouter.ai/api/alpha/decisions
JEV_MODEL=typesafe/jev-1.13
